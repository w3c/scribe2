#!/bin/bash

# Test that v// is not affected by s///

trap 'rm $TMP1 $TMP2 $TMP3 $TMP4' 0
TMP1=`mktemp /tmp/topics-XXXXXX` || exit 1
TMP2=`mktemp /tmp/topics-XXXXXX` || exit 1
TMP3=`mktemp /tmp/topics-XXXXXX` || exit 1
TMP4=`mktemp /tmp/topics-XXXXXX` || exit 1

cat >$TMP1 <<EOF
<foo> Joe: I do that
<bar> subject: Another topic
<foo> ... and the other thing, too.
<foo> Some summary
<foo> v/topic:/
<bar> s/topic:/subject:/
EOF

cat >$TMP2 <<EOF
<main id=meeting class=meeting>
<h2>Meeting minutes</h2>
<section><p id=cacf class="phone s01"><cite>Joe:</cite> I do that</p>
<p id=d5e2 class=irc><cite>&lt;bar&gt;</cite> subject: Another topic</p>
<p id=6bcd class="phone s01"><cite>Joe:</cite> and the other thing, too.</p>
<p id=cbc1 class=summary>Some summary</p>
<p id=8a46 class=irc><cite>&lt;foo&gt;</cite> v/topic:/</p>
<p id=2f91 class=irc><cite>&lt;bar&gt;</cite> s/topic:/subject:/</p>
</section>
</main>
EOF

perl scribe.perl $TMP1 >$TMP3 || exit 1
sed -n -e '/<main/,/<\/main/p' $TMP3 >$TMP4
diff -u $TMP2 $TMP4
